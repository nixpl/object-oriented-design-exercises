{% extends 'base.html.twig' %}
{% block title %}Users List{% endblock %}
{% block body %}
    <h1>Users</h1>
    <table>
        <tr><th>ID</th><th>Email</th></tr>
        {% for user in users %}
            <tr><td>{{ user.id }}</td><td>{{ user.email }}</td></tr>
        {% else %}
            <tr><td colspan="2">No users found. Add some via API!</td></tr>
        {% endfor %}
    </table>
{% endblock %}
