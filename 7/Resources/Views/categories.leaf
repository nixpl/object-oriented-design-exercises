<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Categories</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container mt-5">
    <nav class="nav nav-pills mb-4">
        <a class="nav-link" href="/products/view">Products</a>
        <a class="nav-link active" href="/categories/view">Categories</a>
        <a class="nav-link" href="/reviews/view">Reviews</a>
    </nav>

    <h2>Categories Management</h2>
    
    <div class="card mb-4 mt-4">
        <div class="card-body">
            <h5 class="card-title">Add Category</h5>
            <form action="/categories/view" method="POST" class="row g-3 mt-2">
                <div class="col-auto">
                    <input type="text" name="name" class="form-control" placeholder="Category Name" required>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>

    <table class="table table-bordered" style="table-layout: fixed;">
        <thead class="table-light">
            <tr>
                <th style="width: 70%;">Name</th>
                <th style="width: 30%;">Actions</th>
            </tr>
        </thead>
        <tbody>
            #for(category in categories):
                #if(category.id == editId):
                    <tr class="table-warning">
                        <td class="align-middle">
                            <input type="text" name="name" value="#(category.name)" class="form-control form-control-sm" form="edit-form-#(category.id)" required>
                        </td>
                        <td class="align-middle">
                            <form id="edit-form-#(category.id)" action="/categories/view/#(category.id)/edit" method="POST" class="d-flex gap-2 mb-0">
                                <button type="submit" class="btn btn-sm btn-success">Save</button>
                                <a href="/categories/view" class="btn btn-sm btn-secondary">Cancel</a>
                            </form>
                        </td>
                    </tr>
                #else:
                    <tr>
                        <td class="align-middle text-truncate">#(category.name)</td>
                        <td class="align-middle">
                            <div class="d-flex gap-2">
                                <a href="/categories/view?edit=#(category.id)" class="btn btn-sm btn-warning">Edit</a>
                                <form action="/categories/view/#(category.id)/delete" method="POST" class="mb-0">
                                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                #endif
            #endfor
        </tbody>
    </table>
</body>
</html>
