<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Products</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container mt-5">
    <nav class="nav nav-pills mb-4">
        <a class="nav-link active" href="/products/view">Products</a>
        <a class="nav-link" href="/categories/view">Categories</a>
        <a class="nav-link" href="/reviews/view">Reviews</a>
    </nav>

    <h2>Products Management</h2>
    
    #if(lastAdded != "None"):
    <div class="alert alert-info mt-3" role="alert">
        Last added product in the system: <strong>#(lastAdded)</strong>
    </div>
    #endif
    
    <div class="card mb-4 mt-2">
        <div class="card-body">
            <h5 class="card-title">Add Product</h5>
            <form action="/products/view" method="POST" class="row g-3 mt-2">
                <div class="col-auto">
                    <input type="text" name="name" class="form-control" placeholder="Name" required>
                </div>
                <div class="col-auto">
                    <input type="number" step="0.01" name="price" class="form-control" placeholder="Price" required>
                </div>
                <div class="col-auto">
                    <select name="category_id" class="form-select" required>
                        <option value="" disabled selected>Select Category...</option>
                        #for(category in categories):
                            <option value="#(category.id)">#(category.name)</option>
                        #endfor
                    </select>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>

    <table class="table table-bordered" style="table-layout: fixed;">
        <thead class="table-light">
            <tr>
                <th style="width: 30%;">Name</th>
                <th style="width: 20%;">Price</th>
                <th style="width: 25%;">Category</th>
                <th style="width: 25%;">Actions</th>
            </tr>
        </thead>
        <tbody>
            #for(product in products):
                #if(product.id == editId):
                    <tr class="table-warning">
                        <td class="align-middle">
                            <input type="text" name="name" value="#(product.name)" class="form-control form-control-sm" form="edit-form-#(product.id)" required>
                        </td>
                        <td class="align-middle">
                            <input type="number" step="0.01" name="price" value="#(product.price)" class="form-control form-control-sm" form="edit-form-#(product.id)" required>
                        </td>
                        <td class="align-middle">
                            <select name="category_id" class="form-select form-select-sm" form="edit-form-#(product.id)" required>
                                #for(category in categories):
                                    <option value="#(category.id)" #if(category.id == product.category.id): selected #endif>#(category.name)</option>
                                #endfor
                            </select>
                        </td>
                        <td class="align-middle">
                            <form id="edit-form-#(product.id)" action="/products/view/#(product.id)/edit" method="POST" class="d-flex gap-2 mb-0">
                                <button type="submit" class="btn btn-sm btn-success">Save</button>
                                <a href="/products/view" class="btn btn-sm btn-secondary">Cancel</a>
                            </form>
                        </td>
                    </tr>
                #else:
                    <tr>
                        <td class="align-middle text-truncate">#(product.name)</td>
                        <td class="align-middle text-truncate">#(product.price)</td>
                        <td class="align-middle text-truncate">#(product.category.name)</td>
                        <td class="align-middle">
                            <div class="d-flex gap-2">
                                <a href="/products/view?edit=#(product.id)" class="btn btn-sm btn-warning">Edit</a>
                                <form action="/products/view/#(product.id)/delete" method="POST" class="mb-0">
                                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                #endif
            #endfor
        </tbody>
    </table>
</body>
</html>
